# MySQL Configuration (my.cnf)

[mysqld]
# =========================================================
# 1. CHARACTER SETTINGS
# Full UTF-8 support (emojis, special characters, etc.)
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# =========================================================
# 2. AUTHENTICATION
# MySQL 8.0+ uses caching_sha2_password by default.
# PHP 8.1+ with mysqlnd supports this natively — no override needed.
#
# If you're using an older PHP version or a client that doesn't
# support caching_sha2_password, uncomment the line below:
# default_authentication_plugin = mysql_native_password
#
# Note: MySQL 8.4+ removed this option entirely.
# Use mysql_native_password only as a temporary compatibility fix.

# =========================================================
# 3. INNODB OPTIMIZATION
# Tuned for development. Increase for production workloads.
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M

# =========================================================
# 4. RESOURCE LIMITS
max_allowed_packet = 64M
max_connections = 500

# =========================================================
# 5. STRICT MODE
# Enforces stricter SQL rules (recommended for catching bugs early)
sql_mode = "STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION"

[client]
default-character-set = utf8mb4
